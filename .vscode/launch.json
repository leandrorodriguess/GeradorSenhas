{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SecurePass: servidor web",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "SecurePass: CLI",
      "type": "debugpy",
      "request": "launch",
      "module": "app.cli",
      "args": ["--length", "20", "--uppercase", "--lowercase", "--numbers", "--symbols", "--count", "3"],
      "console": "integratedTerminal"
    }
  ]
}
